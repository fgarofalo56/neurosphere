{
  "id": "who_writes_to_source",
  "question": "Which agents write to the Accounts Payable Invoices source?",
  "phrases": [
    [
      "write",
      "invoice"
    ],
    [
      "write",
      "payable"
    ]
  ],
  "steps": [
    {
      "tool": "search_catalog",
      "arguments": {
        "query": {
          "schema_version": "1.0.0",
          "operation": "list",
          "entity": "grounding_source",
          "budget": {
            "timeout_ms": 5000,
            "limit": 50,
            "max_depth": 0
          }
        }
      }
    },
    {
      "tool": "graph_query",
      "arguments": {
        "query": {
          "schema_version": "1.0.0",
          "operation": "neighbors",
          "entity": "grounding_source",
          "traversal": {
            "start_ids": [
              "$id:ap-invoices"
            ],
            "relations": [
              "writes"
            ],
            "direction": "incoming"
          },
          "budget": {
            "timeout_ms": 5000,
            "limit": 50,
            "max_depth": 1
          }
        }
      }
    }
  ],
  "answer": {
    "intro": "These agents have a recorded write edge to the Accounts Payable Invoices source:",
    "empty": "No agent with a recorded write edge to that source was returned.",
    "exclude_kinds": [
      "grounding_source",
      "graph_edge"
    ],
    "label_fields": [
      "display_name"
    ],
    "detail_fields": [
      "domain_id"
    ]
  }
}
