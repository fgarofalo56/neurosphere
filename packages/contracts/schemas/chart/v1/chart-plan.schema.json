{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/chart/v1/chart-plan.schema.json",
  "title": "ChartPlan",
  "description": "A declarative chart produced by the copilot, a saved report or a dashboard (PRP.md section 3, NS-06, PRP-01 clarification 13). It wraps `spec`, a validated SUBSET of Vega-Lite rendered by a CSP-safe interpreter (vega-interpreter) in a sandboxed frame. The subset is enforced by explicit allowlists with additionalProperties false at every level, not by prose: marks bar, line, area, point, rect, text only; encoding channels x, y, x2, y2, color, size, opacity, text, tooltip only; transforms filter (field predicates only), aggregate, bin, timeUnit, fold only; data is inline `data.values` only, capped at 5000 rows. Therefore expr, signals, params, selections, conditions, calculate, lookup, data url, named data and top-level datasets, $schema, remote $ref, config and usermeta are all rejected because they are not on any allowlist. Field names and any string that Vega-Lite may compile into an expression (filter values, scale domains, formats, titles) are charset-restricted to exclude quotes, backslashes, backticks, braces and control characters. The spec subtree keeps Vega-Lite's own camelCase property names (timeUnit, maxbins, labelAngle, ...) so it can be passed to the compiler unchanged; this is the one documented exception to the snake_case convention. Rules JSON Schema cannot express: every encoding/transform field must exist in data.values rows or be produced by an earlier transform (tests/contracts/validators.py::check_chart_plan_field_references); mark/channel compatibility, e.g. a text mark needs a text channel (tests/contracts/validators.py::check_chart_plan_mark_channels); serialized document size <= 2 MiB (tests/contracts/validators.py::check_chart_plan_size).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "citations", "spec"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/schema_version" },
    "citations": {
      "description": "Evidence behind the plotted data, with data freshness (NS-06 citations with data freshness).",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/citation" }
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "schema_version": {
      "description": "Semantic version of this document within major 1. Within v1 only additive, optional changes are allowed (ADR-0004).",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "timestamp": {
      "description": "RFC 3339 timestamp in UTC (Z suffix required).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "safe_text": {
      "description": "Display text with no quotes, backslashes, backticks, braces or control characters.",
      "type": "string",
      "pattern": "^[^\"'\\\\`{}\\u0000-\\u001f]{0,200}$"
    },
    "safe_scalar": {
      "description": "A scalar that Vega-Lite may compile into an expression literal; strings are charset-restricted.",
      "anyOf": [
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "string", "pattern": "^[^\"'\\\\`{}\\u0000-\\u001f]{0,128}$" }
      ]
    },
    "field_name": {
      "description": "Flat snake_case field name. No dots or brackets (Vega-Lite nested access), no expression syntax.",
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,63}$"
    },
    "format_string": {
      "description": "d3-format or d3-time-format specifier.",
      "type": "string",
      "pattern": "^[A-Za-z0-9 %,.:$+#~/-]{0,32}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "as_of"],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:/=-]{0,255}$"
        },
        "as_of": {
          "description": "Freshness: time the cited data was last observed.",
          "$ref": "#/$defs/timestamp"
        },
        "label": { "$ref": "#/$defs/safe_text" }
      }
    },
    "spec": {
      "description": "Vega-Lite single-view unit spec subset. No layer, concat, facet or repeat in v1.",
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "mark", "encoding"],
      "properties": {
        "title": { "$ref": "#/$defs/safe_text" },
        "description": { "$ref": "#/$defs/safe_text" },
        "width": { "$ref": "#/$defs/size_value" },
        "height": { "$ref": "#/$defs/size_value" },
        "data": { "$ref": "#/$defs/inline_data" },
        "mark": { "$ref": "#/$defs/mark" },
        "encoding": { "$ref": "#/$defs/encoding" },
        "transform": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/transform" }
        }
      }
    },
    "size_value": {
      "oneOf": [
        { "type": "integer", "minimum": 50, "maximum": 2000 },
        { "const": "container" }
      ]
    },
    "inline_data": {
      "description": "Inline data only. url, name (datasets), format, sequence and generators are not allowed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "description": "Row cap 5000.",
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/data_row" }
        }
      }
    },
    "data_row": {
      "type": "object",
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z_][a-z0-9_]{0,63}$": {
          "anyOf": [
            { "type": "string", "maxLength": 1024 },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "mark_type": {
      "enum": ["bar", "line", "area", "point", "rect", "text"]
    },
    "mark": {
      "oneOf": [{ "$ref": "#/$defs/mark_type" }, { "$ref": "#/$defs/mark_def" }]
    },
    "mark_def": {
      "description": "Mark properties take literal values only; ExprRef objects ({expr: ...}) are rejected by the typed properties.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/mark_type" },
        "tooltip": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "filled": { "type": "boolean" },
        "point": { "type": "boolean" },
        "interpolate": {
          "enum": ["linear", "monotone", "step", "step-before", "step-after"]
        },
        "size": { "type": "number", "minimum": 1, "maximum": 10000 },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 20 },
        "align": { "enum": ["left", "center", "right"] },
        "baseline": { "enum": ["top", "middle", "bottom"] },
        "dx": { "type": "number", "minimum": -100, "maximum": 100 },
        "dy": { "type": "number", "minimum": -100, "maximum": 100 },
        "fontSize": { "type": "number", "minimum": 6, "maximum": 64 }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "x": { "$ref": "#/$defs/position_def" },
        "y": { "$ref": "#/$defs/position_def" },
        "x2": { "$ref": "#/$defs/secondary_def" },
        "y2": { "$ref": "#/$defs/secondary_def" },
        "color": { "$ref": "#/$defs/mark_prop_def" },
        "size": { "$ref": "#/$defs/mark_prop_def" },
        "opacity": { "$ref": "#/$defs/mark_prop_def" },
        "text": { "$ref": "#/$defs/text_def" },
        "tooltip": {
          "oneOf": [
            { "$ref": "#/$defs/text_def" },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": { "$ref": "#/$defs/text_def" }
            }
          ]
        }
      }
    },
    "data_type": {
      "enum": ["quantitative", "nominal", "ordinal", "temporal"]
    },
    "aggregate_op": {
      "enum": ["count", "sum", "mean", "median", "min", "max", "distinct"]
    },
    "time_unit": {
      "enum": [
        "year",
        "quarter",
        "month",
        "date",
        "day",
        "hours",
        "minutes",
        "yearmonth",
        "yearmonthdate",
        "yearmonthdatehours",
        "yearmonthdatehoursminutes",
        "monthdate",
        "hoursminutes"
      ]
    },
    "bin_param": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxbins"],
          "properties": {
            "maxbins": { "type": "integer", "minimum": 2, "maximum": 200 }
          }
        }
      ]
    },
    "channel_title": {
      "oneOf": [{ "$ref": "#/$defs/safe_text" }, { "type": "null" }]
    },
    "sort_order": {
      "oneOf": [{ "enum": ["ascending", "descending"] }, { "type": "null" }]
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["linear", "log", "sqrt", "time", "utc", "band", "point", "ordinal"]
        },
        "zero": { "type": "boolean" },
        "nice": { "type": "boolean" },
        "reverse": { "type": "boolean" },
        "domain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/safe_scalar" }
        },
        "scheme": {
          "enum": [
            "category10",
            "tableau10",
            "set2",
            "blues",
            "greens",
            "oranges",
            "reds",
            "purples",
            "greys",
            "viridis",
            "redyellowgreen",
            "blueorange"
          ]
        }
      }
    },
    "axis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "$ref": "#/$defs/channel_title" },
            "format": { "$ref": "#/$defs/format_string" },
            "labelAngle": { "type": "number", "minimum": -90, "maximum": 90 },
            "grid": { "type": "boolean" },
            "tickCount": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        },
        { "type": "null" }
      ]
    },
    "legend": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "$ref": "#/$defs/channel_title" },
            "format": { "$ref": "#/$defs/format_string" },
            "orient": { "enum": ["left", "right", "top", "bottom", "none"] }
          }
        },
        { "type": "null" }
      ]
    },
    "position_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "type"],
      "properties": {
        "field": { "$ref": "#/$defs/field_name" },
        "type": { "$ref": "#/$defs/data_type" },
        "aggregate": { "$ref": "#/$defs/aggregate_op" },
        "timeUnit": { "$ref": "#/$defs/time_unit" },
        "bin": { "$ref": "#/$defs/bin_param" },
        "title": { "$ref": "#/$defs/channel_title" },
        "sort": { "$ref": "#/$defs/sort_order" },
        "scale": { "$ref": "#/$defs/scale" },
        "axis": { "$ref": "#/$defs/axis" },
        "stack": {
          "oneOf": [
            { "enum": ["zero", "normalize", "center"] },
            { "type": "null" },
            { "const": false }
          ]
        }
      }
    },
    "secondary_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/field_name" },
        "aggregate": { "$ref": "#/$defs/aggregate_op" },
        "timeUnit": { "$ref": "#/$defs/time_unit" },
        "title": { "$ref": "#/$defs/channel_title" }
      }
    },
    "mark_prop_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "type"],
      "properties": {
        "field": { "$ref": "#/$defs/field_name" },
        "type": { "$ref": "#/$defs/data_type" },
        "aggregate": { "$ref": "#/$defs/aggregate_op" },
        "timeUnit": { "$ref": "#/$defs/time_unit" },
        "bin": { "$ref": "#/$defs/bin_param" },
        "title": { "$ref": "#/$defs/channel_title" },
        "sort": { "$ref": "#/$defs/sort_order" },
        "scale": { "$ref": "#/$defs/scale" },
        "legend": { "$ref": "#/$defs/legend" }
      }
    },
    "text_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "type"],
      "properties": {
        "field": { "$ref": "#/$defs/field_name" },
        "type": { "$ref": "#/$defs/data_type" },
        "aggregate": { "$ref": "#/$defs/aggregate_op" },
        "timeUnit": { "$ref": "#/$defs/time_unit" },
        "bin": { "$ref": "#/$defs/bin_param" },
        "title": { "$ref": "#/$defs/channel_title" },
        "format": { "$ref": "#/$defs/format_string" }
      }
    },
    "transform": {
      "description": "Transform allowlist: filter (field predicate only), aggregate, bin, timeUnit, fold. calculate, lookup, window, joinaggregate, impute, regression, loess, density, pivot, sample, flatten, extent and stack are rejected.",
      "oneOf": [
        { "$ref": "#/$defs/filter_transform" },
        { "$ref": "#/$defs/aggregate_transform" },
        { "$ref": "#/$defs/bin_transform" },
        { "$ref": "#/$defs/timeunit_transform" },
        { "$ref": "#/$defs/fold_transform" }
      ]
    },
    "filter_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filter"],
      "properties": {
        "filter": { "$ref": "#/$defs/field_predicate" }
      }
    },
    "field_predicate": {
      "description": "Vega-Lite field predicate with exactly one comparison. Expression strings, param predicates and and/or/not composition are rejected.",
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "minProperties": 2,
      "maxProperties": 2,
      "properties": {
        "field": { "$ref": "#/$defs/field_name" },
        "equal": { "$ref": "#/$defs/safe_scalar" },
        "lt": { "$ref": "#/$defs/safe_scalar" },
        "lte": { "$ref": "#/$defs/safe_scalar" },
        "gt": { "$ref": "#/$defs/safe_scalar" },
        "gte": { "$ref": "#/$defs/safe_scalar" },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/safe_scalar" }
        },
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/safe_scalar" }
        },
        "valid": { "type": "boolean" }
      }
    },
    "aggregate_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate"],
      "properties": {
        "aggregate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "as"],
            "properties": {
              "op": { "$ref": "#/$defs/aggregate_op" },
              "field": { "$ref": "#/$defs/field_name" },
              "as": { "$ref": "#/$defs/field_name" }
            }
          }
        },
        "groupby": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/field_name" }
        }
      }
    },
    "bin_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin", "field", "as"],
      "properties": {
        "bin": { "$ref": "#/$defs/bin_param" },
        "field": { "$ref": "#/$defs/field_name" },
        "as": { "$ref": "#/$defs/field_name" }
      }
    },
    "timeunit_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeUnit", "field", "as"],
      "properties": {
        "timeUnit": { "$ref": "#/$defs/time_unit" },
        "field": { "$ref": "#/$defs/field_name" },
        "as": { "$ref": "#/$defs/field_name" }
      }
    },
    "fold_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fold"],
      "properties": {
        "fold": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/field_name" }
        },
        "as": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/field_name" }
        }
      }
    }
  }
}
