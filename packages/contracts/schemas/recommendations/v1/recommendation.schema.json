{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/recommendations/v1/recommendation.schema.json",
  "title": "Recommendation",
  "description": "An evidence-backed suggestion (NS-03): kind, evidence window, coverage, uncertainty, prerequisites, projected estimate and owner. Recommendations are insights, not actions: executing one goes through the shared action executor (schemas/actions/v1). Cold start uses bounded rules rather than fabricated scores: when evidence_status is insufficient_evidence, score must be absent; when score is absent, evidence_status must be insufficient_evidence. A projected_estimate always cites price_version. candidate_duplicate is always advisory (consolidation review, never an automatic merge). Unknown numeric values are null, never 0. Rules JSON Schema cannot express: evidence_window.start < evidence_window.end (tests/contracts/validators.py::check_time_range_order); uncertainty.lower <= score <= uncertainty.upper when both present (tests/contracts/validators.py::check_recommendation_score_interval); every subject_ids and owner_id belongs to the same cloud and customer as the document (tests/contracts/validators.py::check_recommendation_same_boundary).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_id",
    "cloud",
    "customer_id",
    "domain_id",
    "kind",
    "subject_ids",
    "method",
    "evidence_status",
    "evidence_window",
    "evidence_ids",
    "coverage",
    "uncertainty",
    "prerequisites",
    "owner",
    "advisory",
    "created_at"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/schema_version" },
    "recommendation_id": { "$ref": "#/$defs/canonical_id" },
    "cloud": { "enum": ["commercial", "government"] },
    "customer_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,128}$"
    },
    "domain_id": {
      "description": "Canonical Domain ID used for scope filtering against the server-derived IdentityScope.",
      "$ref": "#/$defs/canonical_id"
    },
    "kind": {
      "enum": [
        "cost_spike",
        "latency_degradation",
        "error_rate_degradation",
        "unused_agent",
        "candidate_duplicate",
        "model_right_sizing"
      ]
    },
    "subject_ids": {
      "description": "Canonical IDs of the agents, versions or deployments the recommendation is about.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/canonical_id" }
    },
    "method": {
      "description": "rule for cold-start bounded rules; statistical or ml when enough history exists.",
      "enum": ["rule", "statistical", "ml"]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "generator_version"],
      "properties": {
        "generator_id": { "$ref": "#/$defs/opaque_id" },
        "generator_version": { "$ref": "#/$defs/version" }
      }
    },
    "evidence_status": {
      "enum": ["sufficient", "insufficient_evidence"]
    },
    "score": {
      "description": "Confidence in [0, 1]. Absent on cold start (insufficient_evidence); never fabricated.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_window": { "$ref": "#/$defs/time_range" },
    "evidence_ids": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaque_id" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "uncertainty": { "$ref": "#/$defs/uncertainty" },
    "prerequisites": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "projected_estimate": { "$ref": "#/$defs/projected_estimate" },
    "owner": { "$ref": "#/$defs/owner" },
    "advisory": {
      "description": "True when no supported write connector can execute the change; the recommendation is then advisory only and never a catalog-only pretend change.",
      "type": "boolean"
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidence_status": { "const": "insufficient_evidence" } },
        "required": ["evidence_status"]
      },
      "then": { "not": { "required": ["score"] } },
      "else": { "required": ["score"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "candidate_duplicate" } },
        "required": ["kind"]
      },
      "then": { "properties": { "advisory": { "const": true } } }
    }
  ],
  "$defs": {
    "schema_version": {
      "description": "Semantic version of this document within major 1. Within v1 only additive, optional changes are allowed (ADR-0004).",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "timestamp": {
      "description": "RFC 3339 timestamp in UTC (Z suffix required).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "date": {
      "description": "RFC 3339 full-date (UTC calendar date).",
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "canonical_id": {
      "description": "Canonical ID cloud:customer:source:type:id (PRP-01 clarification 7). Grammar owned by schemas/catalog/v1; duplicated here as a pattern.",
      "type": "string",
      "maxLength": 512,
      "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:[a-z0-9._-]+:[a-z0-9._/=-]+$"
    },
    "opaque_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/=-]{0,255}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,64}$"
    },
    "decimal": {
      "description": "Money amount as a decimal string (no floats).",
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
    },
    "currency": {
      "description": "ISO 4217 alphabetic code.",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/timestamp" },
        "end": { "$ref": "#/$defs/timestamp" }
      }
    },
    "coverage": {
      "description": "How much of the relevant population the evidence observed. observed_fraction null means unknown, never 0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "observed_fraction"],
      "properties": {
        "method": { "enum": ["full", "sampled", "partial", "unknown"] },
        "observed_fraction": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "sampling_rate": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "missing_source_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonical_id" }
        }
      }
    },
    "uncertainty": {
      "description": "Uncertainty of the score or estimate. not_estimable is the honest value on cold start; it carries no bounds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "enum": [
            "confidence_interval",
            "credible_interval",
            "bootstrap",
            "rule_bound",
            "not_estimable"
          ]
        },
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
      },
      "if": {
        "properties": { "method": { "const": "not_estimable" } },
        "required": ["method"]
      },
      "then": {
        "not": {
          "anyOf": [{ "required": ["lower"] }, { "required": ["upper"] }, { "required": ["level"] }]
        }
      },
      "else": { "required": ["lower", "upper"] }
    },
    "prerequisite": {
      "description": "A precondition for acting on the recommendation (NS-03: compatibility, quality regression, cost comparison, staged rollout, rollback).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": {
          "enum": [
            "capability_compatibility",
            "context_compatibility",
            "tool_compatibility",
            "quality_regression_test",
            "cost_comparison",
            "staged_rollout_plan",
            "rollback_plan",
            "owner_consent",
            "approval",
            "write_connector_available"
          ]
        },
        "status": { "enum": ["met", "unmet", "unknown"] },
        "evidence_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaque_id" }
        }
      }
    },
    "projected_estimate": {
      "description": "Projected cost effect. Always an estimate, always cites price_version (estimated spend without a price version is invalid, matching CostRecord).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate_kind",
        "period",
        "baseline_amount",
        "projected_amount",
        "currency",
        "price_version"
      ],
      "properties": {
        "estimate_kind": { "const": "estimated" },
        "period": { "enum": ["monthly", "annual", "evidence_window"] },
        "baseline_amount": { "$ref": "#/$defs/decimal" },
        "projected_amount": { "$ref": "#/$defs/decimal" },
        "lower_amount": { "$ref": "#/$defs/decimal" },
        "upper_amount": { "$ref": "#/$defs/decimal" },
        "currency": { "$ref": "#/$defs/currency" },
        "price_version": { "$ref": "#/$defs/version" },
        "price_effective_date": { "$ref": "#/$defs/date" }
      }
    },
    "owner": {
      "description": "Owner of the subject. resolution unresolved means owner_id is null (owner unknown, routed to stewards).",
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "owner_id"],
      "properties": {
        "resolution": { "enum": ["assigned", "inferred", "unresolved"] },
        "owner_id": {
          "oneOf": [{ "$ref": "#/$defs/canonical_id" }, { "type": "null" }]
        }
      },
      "if": {
        "properties": { "resolution": { "const": "unresolved" } },
        "required": ["resolution"]
      },
      "then": { "properties": { "owner_id": { "type": "null" } } },
      "else": { "properties": { "owner_id": { "$ref": "#/$defs/canonical_id" } } }
    }
  }
}
