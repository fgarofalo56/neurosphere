{
  "description": "Examples for this area. Each invalid example is a valid example with exactly one mutation (derived_from); expected_error names a JSON Schema error (instance_path as a JSON Pointer, validator keyword) that must appear in the validation error tree. Consumed by tests/contracts (PRP-01 item 7).",
  "examples": [
    {
      "file": "valid/recommendation.cost-spike-scored.json",
      "schema": "recommendation.schema.json",
      "valid": true
    },
    {
      "file": "valid/recommendation.cold-start-unused-agent.json",
      "schema": "recommendation.schema.json",
      "valid": true
    },
    {
      "file": "valid/recommendation.model-right-sizing-estimate.json",
      "schema": "recommendation.schema.json",
      "valid": true
    },
    {
      "file": "invalid/recommendation.estimate-without-price-version.json",
      "schema": "recommendation.schema.json",
      "valid": false,
      "derived_from": "valid/recommendation.model-right-sizing-estimate.json",
      "expected_error": {
        "instance_path": "/projected_estimate",
        "keyword": "required"
      },
      "reason": "projected estimate must cite price_version"
    },
    {
      "file": "invalid/recommendation.cold-start-with-score.json",
      "schema": "recommendation.schema.json",
      "valid": false,
      "derived_from": "valid/recommendation.cold-start-unused-agent.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "not"
      },
      "reason": "no fabricated score on insufficient evidence"
    },
    {
      "file": "invalid/recommendation.score-missing-without-insufficient-evidence.json",
      "schema": "recommendation.schema.json",
      "valid": false,
      "derived_from": "valid/recommendation.cost-spike-scored.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "required"
      },
      "reason": "omitting score requires insufficient_evidence"
    },
    {
      "file": "invalid/recommendation.duplicate-not-advisory.json",
      "schema": "recommendation.schema.json",
      "valid": false,
      "derived_from": "valid/recommendation.cost-spike-scored.json",
      "expected_error": {
        "instance_path": "/advisory",
        "keyword": "const"
      },
      "reason": "duplicates are consolidation review only"
    },
    {
      "file": "invalid/recommendation.unresolved-owner-with-id.json",
      "schema": "recommendation.schema.json",
      "valid": false,
      "derived_from": "valid/recommendation.cold-start-unused-agent.json",
      "expected_error": {
        "instance_path": "/owner/owner_id",
        "keyword": "type"
      },
      "reason": "unresolved owner has null owner_id"
    },
    {
      "file": "invalid/recommendation.float-money.json",
      "schema": "recommendation.schema.json",
      "valid": false,
      "derived_from": "valid/recommendation.model-right-sizing-estimate.json",
      "expected_error": {
        "instance_path": "/projected_estimate/baseline_amount",
        "keyword": "type"
      },
      "reason": "money is a decimal string"
    },
    {
      "file": "invalid/recommendation.non-utc-timestamp.json",
      "schema": "recommendation.schema.json",
      "valid": false,
      "derived_from": "valid/recommendation.cost-spike-scored.json",
      "expected_error": {
        "instance_path": "/created_at",
        "keyword": "pattern"
      },
      "reason": "timestamps are RFC 3339 UTC"
    }
  ]
}
