{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/policy/v1/policy-violation.schema.json",
  "title": "PolicyViolation",
  "description": "One deduplicated finding that an entity breaks a rule (PRP-99; container policy_violations). Evidence is references only: no content, no query text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "violation_id",
    "cloud",
    "customer_id",
    "domain_id",
    "policy_id",
    "policy_version",
    "rule_id",
    "rule_kind",
    "severity",
    "subject",
    "status",
    "dedup_key",
    "first_seen_at",
    "last_seen_at",
    "occurrence_count",
    "evidence",
    "correlation_id",
    "evaluator_version"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/schema_version"
    },
    "violation_id": {
      "$ref": "../../audit/v1/audit-record.schema.json#/$defs/uuid"
    },
    "cloud": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/cloud"
    },
    "customer_id": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/customer_id"
    },
    "domain_id": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/domain_id"
    },
    "policy_id": {
      "$ref": "../../admin/v1/common.schema.json#/$defs/slug"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "rule_id": {
      "$ref": "../../admin/v1/common.schema.json#/$defs/slug"
    },
    "rule_kind": {
      "$ref": "policy-definition.schema.json#/$defs/rule_kind"
    },
    "severity": {
      "$ref": "policy-definition.schema.json#/$defs/severity"
    },
    "subject": {
      "description": "The entity in violation.",
      "$ref": "../../actions/v1/target-ref.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "excepted",
        "resolved",
        "superseded"
      ]
    },
    "dedup_key": {
      "description": "Digest of policy, rule and subject so one breach is one violation.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "first_seen_at": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/timestamp"
    },
    "last_seen_at": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/timestamp"
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "exception_id": {
      "description": "Exception that covers it. Null when none.",
      "anyOf": [
        {
          "$ref": "../../audit/v1/audit-record.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resolution": {
      "description": "How it was resolved. Null while open.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolved_at",
            "reason_code",
            "intent_id",
            "audit_id"
          ],
          "properties": {
            "resolved_at": {
              "$ref": "../../catalog/v1/common.schema.json#/$defs/timestamp"
            },
            "reason_code": {
              "$ref": "../../admin/v1/common.schema.json#/$defs/reason_code"
            },
            "intent_id": {
              "description": "Action intent, when the fix went through one.",
              "anyOf": [
                {
                  "$ref": "../../audit/v1/audit-record.schema.json#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "audit_id": {
              "description": "Audit record of the resolution.",
              "anyOf": [
                {
                  "$ref": "../../audit/v1/audit-record.schema.json#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "evaluator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    }
  },
  "$defs": {
    "evidence": {
      "title": "PolicyViolationEvidence",
      "description": "A reference to what showed the breach.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_kind",
        "ref",
        "observed_at"
      ],
      "properties": {
        "evidence_kind": {
          "description": "What `ref` points at. Open-ended: readers must tolerate unknown values.",
          "type": "string",
          "enum": [
            "catalog_entity",
            "relation",
            "interaction_record",
            "aggregate_window",
            "audit_record",
            "telemetry_event",
            "budget_status"
          ]
        },
        "ref": {
          "description": "Opaque reference id or canonical id.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._:/=-]{1,512}$"
        },
        "observed_at": {
          "$ref": "../../catalog/v1/common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
