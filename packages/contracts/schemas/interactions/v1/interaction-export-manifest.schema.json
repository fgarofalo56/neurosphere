{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/interactions/v1/interaction-export-manifest.schema.json",
  "title": "InteractionExportManifest",
  "description": "Manifest of one interaction content export (PRP-99). Metadata only: ids, counts, the purpose and an encrypted bundle reference; no content. Written by PRP-104.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "cloud",
    "customer_id",
    "domain_ids",
    "requested_by",
    "requested_at",
    "purpose",
    "filters",
    "interaction_count",
    "interaction_ids",
    "excluded_count",
    "includes_held_content",
    "bundle",
    "audit_id",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "description": "Contract version of this document, major 1 with additive minor revisions.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "export_id": {
      "description": "Export identifier (lowercase UUID).",
      "$ref": "../../audit/v1/audit-record.schema.json#/$defs/uuid"
    },
    "cloud": {
      "description": "Sovereign cloud boundary.",
      "$ref": "../../catalog/v1/common.schema.json#/$defs/cloud"
    },
    "customer_id": {
      "description": "Customer segment.",
      "$ref": "../../catalog/v1/common.schema.json#/$defs/customer_id"
    },
    "domain_ids": {
      "description": "Domains the export draws from.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "../../catalog/v1/common.schema.json#/$defs/domain_id"
      }
    },
    "requested_by": {
      "description": "Requesting principal (pseudonym).",
      "$ref": "../../admin/v1/common.schema.json#/$defs/principal_id"
    },
    "requested_at": {
      "description": "When requested.",
      "$ref": "../../catalog/v1/common.schema.json#/$defs/timestamp"
    },
    "purpose": {
      "description": "Why the export was requested.",
      "$ref": "interaction-access-purpose.schema.json"
    },
    "filters": {
      "description": "Selection filters.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "agent_ids",
        "detected_categories"
      ],
      "properties": {
        "from": {
          "description": "Start of the window.",
          "$ref": "../../catalog/v1/common.schema.json#/$defs/timestamp"
        },
        "to": {
          "description": "End of the window.",
          "$ref": "../../catalog/v1/common.schema.json#/$defs/timestamp"
        },
        "agent_ids": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "../../catalog/v1/common.schema.json#/$defs/canonical_id"
          },
          "default": []
        },
        "detected_categories": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "detection-finding.schema.json#/$defs/detected_category"
          },
          "default": []
        }
      }
    },
    "interaction_count": {
      "description": "Interactions in the bundle.",
      "type": "integer",
      "minimum": 0
    },
    "interaction_ids": {
      "description": "Interactions in the bundle.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "../../audit/v1/audit-record.schema.json#/$defs/uuid"
      }
    },
    "excluded_count": {
      "description": "Interactions excluded (no permission, expired or held).",
      "type": "integer",
      "minimum": 0
    },
    "includes_held_content": {
      "description": "Whether content under legal hold is included.",
      "type": "boolean"
    },
    "bundle": {
      "description": "Encrypted export bundle.",
      "$ref": "interaction-record.schema.json#/$defs/encrypted_object_ref"
    },
    "audit_id": {
      "description": "Audit record of the export.",
      "$ref": "../../audit/v1/audit-record.schema.json#/$defs/uuid"
    },
    "expires_at": {
      "description": "When the bundle expires.",
      "$ref": "../../catalog/v1/common.schema.json#/$defs/timestamp"
    }
  }
}
