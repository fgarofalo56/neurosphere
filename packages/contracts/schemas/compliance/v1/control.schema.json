{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/compliance/v1/control.schema.json",
  "title": "Control",
  "description": "One control of an external framework held as library data (PRP-56). Metadata only: a short paraphrased title and a link to the official source, never copied text. A control record says what the framework names; it never says whether anyone meets it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_id",
    "framework_id",
    "title",
    "source_url",
    "source_retrieved",
    "framework_version"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/schema_version" },
    "control_id": {
      "description": "Stable NeuroSphere control id (lowercase, dot separated). Other PRPs cite it.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "framework_id": { "$ref": "#/$defs/framework_id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_url": { "type": "string", "pattern": "^https://[^\\s]{1,500}$" },
    "source_retrieved": {
      "description": "Date the control id and title were read from the official source.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "framework_version": { "type": "string", "minLength": 1, "maxLength": 64 }
  },
  "$defs": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "framework_id": {
      "type": "string",
      "enum": ["nist_ai_rmf", "sr_11_7", "hipaa_technical_safeguards", "omb_m_25_21"]
    }
  }
}
