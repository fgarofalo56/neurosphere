{
  "schema_version": "1.0.0",
  "name": "foundry_deployments",
  "version": "0.3.1-beta.1",
  "supported_clouds": [
    "government"
  ],
  "capabilities": [
    "catalog_discovery",
    "action_execution"
  ],
