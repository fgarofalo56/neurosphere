    {
      "file": "invalid/structured-query.telemetry-without-time-range.json",
      "schema": "structured-query.schema.json",
      "valid": false,
      "derived_from": "valid/structured-query.aggregate-cost-by-day.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "required"
      },
