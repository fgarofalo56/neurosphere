      "file": "invalid/structured-query.filter-value-injection.json",
      "schema": "structured-query.schema.json",
      "valid": false,
      "derived_from": "valid/structured-query.list-agents.json",
      "expected_error": {
        "instance_path": "/filters/1/value",
        "keyword": "pattern"
      },
      "reason": "keyword values cannot carry query syntax"
    },
    {
      "file": "invalid/structured-query.unknown-filter-field.json",
      "schema": "structured-query.schema.json",
      "valid": false,
      "derived_from": "valid/structured-query.list-agents.json",
      "expected_error": {
        "instance_path": "/filters/0",
        "keyword": "oneOf"
      },
      "reason": "filter fields are allowlisted"
    },
    {
      "file": "invalid/structured-query.bad-operator-for-type.json",
      "schema": "structured-query.schema.json",
      "valid": false,
      "derived_from": "valid/structured-query.list-agents.json",
