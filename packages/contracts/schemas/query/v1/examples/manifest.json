      },
      "reason": "budget is mandatory"
    },
    {
      "file": "invalid/structured-query.budget-missing-timeout.json",
      "schema": "structured-query.schema.json",
      "valid": false,
      "derived_from": "valid/structured-query.list-agents.json",
      "expected_error": {
        "instance_path": "/budget",
        "keyword": "required"
      },
      "reason": "timeout_ms is mandatory"
    },
    {
      "file": "invalid/structured-query.budget-limit-over-max.json",
      "schema": "structured-query.schema.json",
      "valid": false,
      "derived_from": "valid/structured-query.list-agents.json",
      "expected_error": {
        "instance_path": "/budget/limit",
        "keyword": "maximum"
      },
      "reason": "limit ceiling"
    },
    {
      "file": "invalid/structured-query.free-text-query.json",
      "schema": "structured-query.schema.json",
      "valid": false,
      "derived_from": "valid/structured-query.list-agents.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "additionalProperties"
      },
      "reason": "no free-text field can carry query text"
