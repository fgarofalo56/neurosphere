    {
      "file": "invalid/structured-query.traversal-on-list.json",
      "schema": "structured-query.schema.json",
      "valid": false,
      "derived_from": "valid/structured-query.list-agents.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "not"
      },
      "reason": "traversal only on graph operations"
