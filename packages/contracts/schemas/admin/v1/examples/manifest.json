    {
      "file": "valid/principal-access-summary.typical.json",
      "schema": "principal-access-summary.schema.json",
      "valid": true
    },
    {
      "file": "invalid/principal-access-summary.privileged-without-expiry.json",
      "schema": "principal-access-summary.schema.json",
