    {
      "file": "invalid/revocation-status.revoked-without-time.json",
      "schema": "revocation-status.schema.json",
      "valid": false,
      "derived_from": "valid/revocation-status.revoked.json",
      "expected_error": {
        "instance_path": "/revoked_at",
