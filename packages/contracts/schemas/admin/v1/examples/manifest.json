        "instance_path": "/principal_id",
        "keyword": "pattern"
      },
      "reason": "principal ids are pseudonymous"
    },
    {
      "file": "invalid/domain-membership-change.non-domain-id.json",
      "schema": "domain-membership-change.schema.json",
      "valid": false,
      "derived_from": "valid/domain-membership-change.add.json",
      "expected_error": {
        "instance_path": "/domain_id",
        "keyword": "pattern"
      },
      "reason": "membership targets a Domain id"
