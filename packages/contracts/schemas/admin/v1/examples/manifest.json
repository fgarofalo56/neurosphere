    {
      "file": "valid/resource-grant-change.read-export.json",
      "schema": "resource-grant-change.schema.json",
      "valid": true
    },
    {
      "file": "invalid/resource-grant-change.missing-expiry.json",
      "schema": "resource-grant-change.schema.json",
      "valid": false,
      "derived_from": "valid/resource-grant-change.read-export.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "required"
      },
      "reason": "grants are always time-bound"
    },
    {
      "file": "invalid/resource-grant-change.unknown-permission.json",
      "schema": "resource-grant-change.schema.json",
      "valid": false,
      "derived_from": "valid/resource-grant-change.read-export.json",
      "expected_error": {
        "instance_path": "/permissions/1",
        "keyword": "enum"
      },
      "reason": "grant permissions are the closed resource set"
