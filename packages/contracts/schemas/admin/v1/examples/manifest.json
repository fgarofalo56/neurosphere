{
  "description": "Examples for admin v1 (PRP-37). Each invalid example is a valid example with exactly one mutation (derived_from); expected_error names a JSON Schema error (instance_path as a JSON Pointer, validator keyword) that must appear in the validation error tree. Consumed by tests/contracts.",
  "library_schemas": [
    "common.schema.json"
  ],
  "examples": [
    {
      "file": "valid/credential-reference.key-vault-secret.json",
      "schema": "credential-reference.schema.json",
      "valid": true
    },
    {
      "file": "valid/credential-reference.government-key-vault.json",
      "schema": "credential-reference.schema.json",
      "valid": true
    },
    {
      "file": "valid/credential-reference.managed-identity.json",
      "schema": "credential-reference.schema.json",
      "valid": true
    },
    {
      "file": "invalid/credential-reference.secret-value.json",
      "schema": "credential-reference.schema.json",
      "valid": false,
      "derived_from": "valid/credential-reference.key-vault-secret.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "additionalProperties"
      },
      "reason": "no member can hold a credential value"
    },
    {
      "file": "invalid/credential-reference.sas-url.json",
      "schema": "credential-reference.schema.json",
      "valid": false,
      "derived_from": "valid/credential-reference.key-vault-secret.json",
      "expected_error": {
        "instance_path": "/secret_uri",
        "keyword": "pattern"
      },
      "reason": "only a Key Vault secret identifier, never a signed URL"
    },
    {
      "file": "invalid/credential-reference.managed-identity-with-secret-uri.json",
      "schema": "credential-reference.schema.json",
      "valid": false,
      "derived_from": "valid/credential-reference.managed-identity.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "not"
      },
      "reason": "exactly one reference form"
    },
    {
      "file": "invalid/credential-reference.key-vault-without-uri.json",
      "schema": "credential-reference.schema.json",
      "valid": false,
      "derived_from": "valid/credential-reference.key-vault-secret.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "required"
      },
      "reason": "key_vault_secret needs secret_uri"
    },
    {
      "file": "valid/role-assignment-change.assign-viewer.json",
      "schema": "role-assignment-change.schema.json",
      "valid": true
    },
    {
      "file": "valid/role-assignment-change.assign-admin-time-bound.json",
      "schema": "role-assignment-change.schema.json",
      "valid": true
    },
    {
      "file": "valid/role-assignment-change.remove.json",
      "schema": "role-assignment-change.schema.json",
      "valid": true
    },
    {
      "file": "invalid/role-assignment-change.admin-without-expiry.json",
      "schema": "role-assignment-change.schema.json",
      "valid": false,
      "derived_from": "valid/role-assignment-change.assign-admin-time-bound.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "required"
      },
      "reason": "privileged roles are time-bound (PolicyRoleAssignment)"
    },
    {
      "file": "invalid/role-assignment-change.upn-principal.json",
      "schema": "role-assignment-change.schema.json",
      "valid": false,
      "derived_from": "valid/role-assignment-change.assign-viewer.json",
      "expected_error": {
        "instance_path": "/principal_id",
        "keyword": "pattern"
      },
      "reason": "principal ids are pseudonymous, never a UPN or email"
    },
    {
      "file": "invalid/role-assignment-change.wildcard-domain.json",
      "schema": "role-assignment-change.schema.json",
      "valid": false,
      "derived_from": "valid/role-assignment-change.assign-viewer.json",
      "expected_error": {
        "instance_path": "/domain_ids/0",
        "keyword": "pattern"
      },
      "reason": "no wildcard or all-domains form"
    },
    {
      "file": "invalid/role-assignment-change.free-text-reason.json",
      "schema": "role-assignment-change.schema.json",
      "valid": false,
      "derived_from": "valid/role-assignment-change.assign-viewer.json",
      "expected_error": {
        "instance_path": "/reason",
        "keyword": "pattern"
      },
      "reason": "reasons are machine codes, never free text"
    },
    {
      "file": "invalid/role-assignment-change.assign-without-role.json",
      "schema": "role-assignment-change.schema.json",
      "valid": false,
      "derived_from": "valid/role-assignment-change.assign-viewer.json",
      "expected_error": {
        "instance_path": "",
        "keyword": "required"
      },
      "reason": "assign names the role"
    },
    {
      "file": "valid/domain-membership-change.add.json",
