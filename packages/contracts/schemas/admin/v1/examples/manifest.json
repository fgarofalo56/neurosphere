    },
    {
      "file": "invalid/revocation-request.free-text-reason.json",
      "schema": "revocation-request.schema.json",
      "valid": false,
      "derived_from": "valid/revocation-request.until-lifted.json",
      "expected_error": {
        "instance_path": "/reason",
        "keyword": "pattern"
      },
      "reason": "reasons are machine codes"
    },
    {
      "file": "invalid/revocation-request.unknown-mode.json",
      "schema": "revocation-request.schema.json",
      "valid": false,
      "derived_from": "valid/revocation-request.until-lifted.json",
      "expected_error": {
        "instance_path": "/mode",
        "keyword": "enum"
      },
      "reason": "closed mode set"
    },
    {
      "file": "valid/revocation-status.not-revoked.json",
      "schema": "revocation-status.schema.json",
      "valid": true
    },
    {
      "file": "valid/revocation-status.revoked.json",
      "schema": "revocation-status.schema.json",
      "valid": true
    },
    {
      "file": "invalid/revocation-status.not-revoked-with-reason.json",
      "schema": "revocation-status.schema.json",
      "valid": false,
      "derived_from": "valid/revocation-status.not-revoked.json",
