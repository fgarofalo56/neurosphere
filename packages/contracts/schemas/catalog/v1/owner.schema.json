{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/catalog/v1/owner.schema.json",
  "title": "Owner",
  "x-ns-name": "Owner",
  "description": "Accountable owner (team, group, service principal or pseudonymous person) targeted by OWNED_BY. A person-kind owner carries no display_name; it points at a Person. Python validators: validate_canonical_id_fullmatch (Python re.search lets '$' match before a trailing newline; the suite re-checks every canonical ID with re.fullmatch), validate_customer_segment_matches (customer segment of every canonical ID equals customer_id), validate_timestamp_order (created_at <= updated_at).",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:owner:[a-z0-9._/=-]+$",
      "description": "Stable canonical ID of this entity. Canonical ID (canonical_id.schema.json) whose type segment is 'owner'."
    },
    "entity_type": {
      "type": "string",
      "const": "owner"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/entity_version"
    },
    "etag": {
      "$ref": "common.schema.json#/$defs/etag"
    },
    "lifecycle_status": {
      "$ref": "common.schema.json#/$defs/lifecycle_status"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "cloud": {
      "$ref": "common.schema.json#/$defs/cloud"
    },
    "customer_id": {
      "$ref": "common.schema.json#/$defs/customer_id"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/domain_id"
    },
    "classification": {
      "$ref": "common.schema.json#/$defs/classification"
    },
    "residency_region": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/token"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Azure region holding the authoritative copy; null when unknown."
    },
    "attributes": {
      "$ref": "common.schema.json#/$defs/attributes"
    },
    "owner_kind": {
      "type": "string",
      "enum": [
        "person",
        "group",
        "team",
        "service_principal"
      ]
    },
    "display_name": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/display_name"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "principal_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/person_id"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recertified_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recertify_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "version",
    "etag",
    "lifecycle_status",
    "created_at",
    "updated_at",
    "cloud",
    "customer_id",
    "domain_id",
    "owner_kind"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "cloud": {
            "const": "commercial"
          }
        },
        "required": [
          "cloud"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          },
          "principal_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cloud": {
            "const": "government"
          }
        },
        "required": [
          "cloud"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          },
          "principal_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "owner_kind": {
            "const": "person"
          }
        },
        "required": [
          "owner_kind"
        ]
      },
      "then": {
        "required": [
          "principal_id"
        ],
        "properties": {
          "display_name": {
            "type": "null"
          },
          "principal_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
