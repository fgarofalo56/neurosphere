{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/catalog/v1/common.schema.json",
  "title": "CatalogCommon",
  "description": "Shared definitions for catalog v1. Definition library only: it declares no root instance shape and is never validated against directly, so it has no examples.",
  "$defs": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Contract version of the document; major 1 for every catalog v1 schema."
    },
    "canonical_id": {
      "$ref": "canonical_id.schema.json"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 timestamp in UTC (Z suffix required; no offsets)."
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "RFC 3339 full-date."
    },
    "entity_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic document version, incremented on every accepted write."
    },
    "etag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Opaque optimistic-concurrency token. A mismatch on write returns the stale_version error."
    },
    "cloud": {
      "type": "string",
      "enum": [
        "commercial",
        "government"
      ],
      "description": "Sovereign cloud boundary. Government data is never bridged to Commercial."
    },
    "customer_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$",
      "maxLength": 128,
      "description": "Customer segment of the canonical ID grammar."
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128,
      "description": "Lowercase identifier token (source IDs, platforms, providers, kinds)."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "Entity lifecycle state."
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "unknown"
      ],
      "default": "unknown",
      "description": "Data classification label; unknown when not yet classified."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "Human-readable label for a non-person entity. Never a person's name."
    },
    "attributes": {
      "type": "object",
      "description": "Extension point: scalar values only (string, number, boolean, null); keys are lowercase snake_case. Nested objects and arrays are rejected.",
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/=-]{0,255}$",
      "description": "Reference to an evidence record (trace, span, access log, audit record or steward decision). A pointer, never the evidence payload."
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "invokes",
        "delegates_to",
        "uses_model",
        "reads",
        "writes",
        "grounded_by",
        "owned_by",
        "depends_on",
        "supersedes"
      ],
      "description": "Relation name in wire form (lowercase snake_case of INVOKES, DELEGATES_TO, USES_MODEL, READS, WRITES, GROUNDED_BY, OWNED_BY, DEPENDS_ON, SUPERSEDES)."
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "person",
        "agent",
        "agent_version",
        "model_deployment",
        "grounding_source",
        "tool",
        "service",
        "domain",
        "owner",
        "policy",
        "recommendation",
        "run_reference"
      ],
      "description": "Catalog entity type; equals the type segment of the entity's canonical ID."
    },
    "relation_status": {
      "type": "string",
      "enum": [
        "asserted",
        "inferred",
        "curated"
      ],
      "description": "asserted = declared by an authorized source; inferred = derived from telemetry or similarity; curated = accepted, overridden or locked by a domain steward."
    },
    "person_id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:person:[a-z0-9._/=-]+$",
      "description": "Pseudonymous principal reference. Canonical ID (canonical_id.schema.json) whose type segment is 'person'."
    },
    "domain_id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:domain:[a-z0-9._/=-]+$",
      "description": "Owning domain; authorization scope anchor. Canonical ID (canonical_id.schema.json) whose type segment is 'domain'."
    },
    "provenance": {
      "type": "object",
      "description": "Where an edge or alias came from.",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "trace_observation",
            "observed_access",
            "declared",
            "embedding_similarity",
            "steward_curation",
            "import",
            "unknown"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/token",
          "description": "Connector or source that produced the observation."
        },
        "connector_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inference_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version of the inference rule or model when method is inferred."
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "method",
        "source_id",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "description": "Validity interval. valid_to null means open-ended. Python validator validate_validity_interval enforces valid_from < valid_to.",
      "properties": {
        "valid_from": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "valid_from"
      ],
      "additionalProperties": false
    },
    "lock": {
      "type": "object",
      "description": "Steward lock. Locks change presented lineage, never retained observations; re-inference must respect them. A lock (locked=true) requires reason, expiry and actor. Python validator validate_lock_expiry_after_decision enforces expiry later than the decision time.",
      "properties": {
        "locked": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expiry": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/person_id"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "locked"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "locked": {
            "const": true
          }
        },
        "required": [
          "locked"
        ]
      },
      "then": {
        "required": [
          "reason",
          "expiry",
          "actor"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "expiry": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          }
        }
      }
    },
    "curation": {
      "type": "object",
      "description": "Latest steward decision on an edge (full history lives in the audit log).",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "overridden"
          ]
        },
        "decided_by": {
          "$ref": "#/$defs/person_id"
        },
        "decided_at": {
          "$ref": "#/$defs/timestamp"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "override_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512,
              "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:edge_override:[a-z0-9._/=-]+$",
              "description": "Override document that produced this state. Canonical ID (canonical_id.schema.json) whose type segment is 'edge_override'."
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_id"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "decision",
        "decided_by",
        "decided_at",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
