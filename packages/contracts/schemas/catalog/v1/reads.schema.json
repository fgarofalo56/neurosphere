{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/catalog/v1/reads.schema.json",
  "title": "ReadsRelation",
  "x-ns-name": "READS",
  "description": "READS relation. Source reads data from the target data asset. Every edge carries provenance, evidence_ids, confidence, first/last observation, validity interval, status and lock. Only curated edges may be locked; a curated edge carries its curation decision. Python validators: validate_canonical_id_fullmatch, validate_customer_segment_matches, validate_observation_order (first_observed <= last_observed), validate_validity_interval, validate_security_evidence_subset (security_evidence_ids is a subset of evidence_ids), validate_override_preserves_security_evidence (a new edge version keeps every prior security_evidence_ids entry), validate_lock_expiry_after_decision.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:reads:[a-z0-9._/=-]+$",
      "description": "Stable canonical ID of this edge. Canonical ID (canonical_id.schema.json) whose type segment is 'reads'."
    },
    "relation_type": {
      "type": "string",
      "const": "reads"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/entity_version"
    },
    "etag": {
      "$ref": "common.schema.json#/$defs/etag"
    },
    "source_id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:(agent|agent_version|tool|service):[a-z0-9._/=-]+$",
      "description": "Edge source entity. Canonical ID (canonical_id.schema.json) whose type segment is 'agent' or 'agent_version' or 'tool' or 'service'."
    },
    "target_id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:(grounding_source|service):[a-z0-9._/=-]+$",
      "description": "Edge target entity. Canonical ID (canonical_id.schema.json) whose type segment is 'grounding_source' or 'service'."
    },
    "cloud": {
      "$ref": "common.schema.json#/$defs/cloud"
    },
    "customer_id": {
      "$ref": "common.schema.json#/$defs/customer_id"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/domain_id"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {
        "$ref": "common.schema.json#/$defs/evidence_id"
      },
      "description": "Evidence references; must be non-empty when status is inferred."
    },
    "security_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {
        "$ref": "common.schema.json#/$defs/evidence_id"
      },
      "description": "Subset of evidence_ids that is security evidence. Overrides can never remove an entry (see edge_override.schema.json)."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "first_observed": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "last_observed": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "validity": {
      "$ref": "common.schema.json#/$defs/validity"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/relation_status"
    },
    "lock": {
      "$ref": "common.schema.json#/$defs/lock"
    },
    "curation": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/curation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "attributes": {
      "$ref": "common.schema.json#/$defs/attributes"
    }
  },
  "required": [
    "schema_version",
    "id",
    "relation_type",
    "version",
    "etag",
    "source_id",
    "target_id",
    "cloud",
    "customer_id",
    "domain_id",
    "provenance",
    "evidence_ids",
    "security_evidence_ids",
    "confidence",
    "first_observed",
    "last_observed",
    "validity",
    "status",
    "lock",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "cloud": {
            "const": "commercial"
          }
        },
        "required": [
          "cloud"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cloud": {
            "const": "government"
          }
        },
        "required": [
          "cloud"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "inferred"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "asserted",
              "inferred"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lock": {
            "properties": {
              "locked": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "curated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "curation"
        ],
        "properties": {
          "curation": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
