{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/catalog/v1/policy.schema.json",
  "title": "Policy",
  "x-ns-name": "Policy",
  "description": "Governance policy applied to catalog entities (access, data handling, model usage, cost). Python validators: validate_canonical_id_fullmatch (Python re.search lets '$' match before a trailing newline; the suite re-checks every canonical ID with re.fullmatch), validate_customer_segment_matches (customer segment of every canonical ID equals customer_id), validate_timestamp_order (created_at <= updated_at).",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(commercial|government):[a-z0-9._-]+:[a-z0-9._-]+:policy:[a-z0-9._/=-]+$",
      "description": "Stable canonical ID of this entity. Canonical ID (canonical_id.schema.json) whose type segment is 'policy'."
    },
    "entity_type": {
      "type": "string",
      "const": "policy"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/entity_version"
    },
    "etag": {
      "$ref": "common.schema.json#/$defs/etag"
    },
    "lifecycle_status": {
      "$ref": "common.schema.json#/$defs/lifecycle_status"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "cloud": {
      "$ref": "common.schema.json#/$defs/cloud"
    },
    "customer_id": {
      "$ref": "common.schema.json#/$defs/customer_id"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/domain_id"
    },
    "classification": {
      "$ref": "common.schema.json#/$defs/classification"
    },
    "residency_region": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/token"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Azure region holding the authoritative copy; null when unknown."
    },
    "attributes": {
      "$ref": "common.schema.json#/$defs/attributes"
    },
    "display_name": {
      "$ref": "common.schema.json#/$defs/display_name"
    },
    "policy_kind": {
      "type": "string",
      "enum": [
        "access",
        "data_handling",
        "model_usage",
        "cost",
        "retention",
        "approval",
        "other"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "enforced",
        "advisory",
        "disabled"
      ]
    },
    "effective_from": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "effective_to": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "document_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "version",
    "etag",
    "lifecycle_status",
    "created_at",
    "updated_at",
    "cloud",
    "customer_id",
    "domain_id",
    "display_name",
    "policy_kind",
    "policy_version",
    "enforcement",
    "effective_from"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "cloud": {
            "const": "commercial"
          }
        },
        "required": [
          "cloud"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^commercial:"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cloud": {
            "const": "government"
          }
        },
        "required": [
          "cloud"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^government:"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  ]
}
