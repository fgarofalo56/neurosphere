<fragment>
	<validate-azure-ad-token tenant-id="{{[[tenant_named_value]]}}" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" output-token-variable-name="ns-jwt">
		<audiences>
			<audience>{{[[audience_named_value]]}}</audience>
		</audiences>
	</validate-azure-ad-token>
	<set-header name="Authorization" exists-action="delete" />
	<set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
	<set-header name="api-key" exists-action="delete" />
	<set-header name="subscription-key" exists-action="delete" />[[managed_identity]]
	<rate-limit-by-key calls="[[calls]]" renewal-period="[[renewal_period]]" counter-key='@(((Jwt)context.Variables["ns-jwt"]).Claims.GetValueOrDefault("oid", "anonymous"))' />
</fragment>
