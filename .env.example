# Copy to .env (gitignored). Placeholders only; real values come from Key Vault /
# managed identity in any deployed environment. The repo hooks and CI block .env.

# --- Runtime profile ---
NS_ENV=local                      # local | dev | prod   (dev issuer allowed only when local)
NS_CLOUD=commercial               # commercial | government
NS_MODE=synthetic                 # synthetic | live     (live requires consented connectors)
NS_LIVE_APPROVED=0                # 1 only when an operator approved a paid/cloud gate run

# --- Local emulators (docker compose) ---
NS_COSMOS_ENDPOINT=http://localhost:8081
NS_COSMOS_EMULATOR=1              # vNext emulator enforces no auth
NS_COSMOS_DATABASE=neurosphere
NS_EVENTHUB_EMULATOR=1
NS_EVENTHUB_HOST=localhost:5672
NS_EVENTHUB_NAME=telemetry
NS_STORAGE_EMULATOR=1             # Azurite on 10000/10001/10002
NS_SEARCH_PROVIDER=fixture        # fixture | azure

# --- Entra ID (placeholders; never commit real ids/secrets) ---
NS_ENTRA_TENANT_ID=<tenant-guid>
NS_ENTRA_CLIENT_ID=<api-app-registration-guid>
NS_ENTRA_AUDIENCE=api://neurosphere
NS_ENTRA_AUTHORITY_HOST=login.microsoftonline.com   # login.microsoftonline.us for Government

# --- Model endpoint (only used when NS_MODE=live and approved) ---
NS_MODEL_ENDPOINT=<https://your-resource.openai.azure.com>
NS_MODEL_DEPLOYMENT=<deployment-name>

# --- Observability ---
NS_OTEL_EXPORTER=console          # console | azure-monitor
NS_LOG_LEVEL=INFO

# --- MCP server (PRP-22) ---------------------------------------------------
# The MCP server is its own OAuth 2.1 protected resource, separate from the REST API.
# Leave NS_MCP_RESOURCE_SERVER_URL unset to keep MCP off; the endpoint then returns 503.
# The MCP resource identifier: HTTPS only, the path must be exactly /mcp, no query or fragment.
NS_MCP_RESOURCE_SERVER_URL=https://api.example.invalid/mcp
# JSON list of accepted token audiences: the MCP Entra app's application ID URI and/or client id.
# Empty [] means the resource URL above. It must NOT overlap the REST API audience.
NS_MCP_AUDIENCES=[]
# Delegated scope every MCP caller must hold. Without it the server returns 403 insufficient_scope.
NS_MCP_REQUIRED_SCOPE=mcp.invoke
# JSON list of extra Host header values for the DNS-rebinding guard, e.g. an ingress host.
# Entries are exact lowercase host[:port]. The resource host is always allowed.
NS_MCP_ALLOWED_HOSTS=[]