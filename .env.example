# Copy to .env (gitignored). Placeholders only; real values come from Key Vault /
# managed identity in any deployed environment. The repo hooks and CI block .env.

# --- Runtime profile ---
NS_ENV=local                      # local | dev | prod   (dev issuer allowed only when local)
NS_CLOUD=commercial               # commercial | government
NS_MODE=synthetic                 # synthetic | live     (live requires consented connectors)
NS_LIVE_APPROVED=0                # 1 only when an operator approved a paid/cloud gate run

# --- Local emulators (docker compose) ---
NS_COSMOS_ENDPOINT=http://localhost:8081
NS_COSMOS_EMULATOR=1              # vNext emulator enforces no auth
NS_COSMOS_DATABASE=neurosphere
NS_EVENTHUB_EMULATOR=1
NS_EVENTHUB_HOST=localhost:5672
NS_EVENTHUB_NAME=telemetry
NS_STORAGE_EMULATOR=1             # Azurite on 10000/10001/10002
NS_SEARCH_PROVIDER=fixture        # fixture | azure

# --- Entra ID (placeholders; never commit real ids/secrets) ---
NS_ENTRA_TENANT_ID=<tenant-guid>
NS_ENTRA_CLIENT_ID=<api-app-registration-guid>
NS_ENTRA_AUDIENCE=api://neurosphere
NS_ENTRA_AUTHORITY_HOST=login.microsoftonline.com   # login.microsoftonline.us for Government

# --- Model endpoint (only used when NS_MODE=live and approved) ---
NS_MODEL_ENDPOINT=<https://your-resource.openai.azure.com>
NS_MODEL_DEPLOYMENT=<deployment-name>

# --- Observability ---
NS_OTEL_EXPORTER=console          # console | azure-monitor
NS_LOG_LEVEL=INFO

# --- MCP server (PRP-22) ---------------------------------------------------
# The MCP server is its own OAuth 2.1 protected resource, separate from the REST API.
# Leave NS_MCP_RESOURCE_SERVER_URL unset to keep MCP off; the endpoint then returns 503.
# The MCP resource identifier: HTTPS only, the path must be exactly /mcp, no query or fragment.
NS_MCP_RESOURCE_SERVER_URL=https://api.example.invalid/mcp
# JSON list of accepted token audiences: the MCP Entra app's application ID URI and/or client id.
# Empty [] means the resource URL above. It must NOT overlap the REST API audience.
NS_MCP_AUDIENCES=[]
# Delegated scope every MCP caller must hold. Without it the server returns 403 insufficient_scope.
NS_MCP_REQUIRED_SCOPE=mcp.invoke
# JSON list of extra Host header values for the DNS-rebinding guard, e.g. an ingress host.
# Entries are exact lowercase host[:port]. The resource host is always allowed.
NS_MCP_ALLOWED_HOSTS=[]
# Deployment resource scan route (POST /v1/deploy/scan); false keeps it failing closed with 503.
NS_SCAN_ENABLED=false

# Deploy apply + uninstall preview (PRP-08 item 14). Off by default (routes answer 503). Names only.
NS_DEPLOY_APPLY_ENABLED=false
# NS_DEPLOY_APPLY_REGISTER_CONTAINER=

# PRP-16 round 2: evaluation worker (offline pilot, calibration label loop, judge selection)
NS_WORKER_EVAL_DATA_DIR=
NS_WORKER_EVAL_JUDGE=fixture
NS_WORKER_EVAL_JUDGE_ENDPOINT=
NS_WORKER_EVAL_JUDGE_DEPLOYMENT=
NS_WORKER_EVAL_JUDGE_API_VERSION=
NS_WORKER_EVAL_PILOT_DATASET_IDS=sbx-groundedness-pilot
NS_WORKER_EVAL_PILOT_DOMAIN_ID=
NS_WORKER_EVAL_PILOT_SUBJECT_ID=
NS_WORKER_EVAL_OFFLINE_INTERVAL_SECONDS=86400
NS_WORKER_EVAL_CALIBRATION_SAMPLE_CAP=20
NS_EVALUATION_PILOT_DATASET_IDS=sbx-groundedness-pilot

# --- PRP-09 round 2: connector runners (all roles idle until configured) ---
# otel profile: '<producer_id>.<secret>' for the collector's ingest push; set in your shell, never commit a value
NS_PRODUCER_CREDENTIAL=
# foundry_discovery: comma list of <resource>/<project>
NS_FOUNDRY_DISCOVERY_PROJECTS=
# foundry_discovery: canonical domain id cloud:customer:source:domain:id
NS_FOUNDRY_DISCOVERY_DOMAIN_ID=
# foundry_discovery: poll interval, 60..86400 (default 900)
NS_FOUNDRY_DISCOVERY_INTERVAL_SECONDS=
# foundry_discovery: items per list per project per tick (default 500)
NS_FOUNDRY_DISCOVERY_MAX_ITEMS=
# foundry_discovery: reader page budget per tick (default 10)
NS_FOUNDRY_DISCOVERY_MAX_PAGES=
# billing_export: https://<account>.blob.core.windows.net
NS_BILLING_EXPORT_STORAGE_ACCOUNT_URL=
# billing_export: export container name
NS_BILLING_EXPORT_CONTAINER=
# billing_export: path of the export run's manifest.json
NS_BILLING_EXPORT_MANIFEST_BLOB=
# billing_export: canonical domain id cloud:customer:source:domain:id
NS_BILLING_EXPORT_DOMAIN_ID=
# billing_export: ingest API base URL (falls back to NS_API_BASE_URL)
NS_BILLING_EXPORT_API_BASE_URL=
# billing_export: ingest producer id (default azure-billing-export; register its source as kind billing)
NS_BILLING_EXPORT_PRODUCER_ID=
# billing_export: ingest producer secret; from Key Vault in hosted envs, never commit a value
NS_BILLING_EXPORT_PRODUCER_SECRET=
# billing_export: 3600..86400 (default 21600)
NS_BILLING_EXPORT_INTERVAL_SECONDS=
# billing_export: actual or amortized (default actual)
NS_BILLING_EXPORT_BASIS=
