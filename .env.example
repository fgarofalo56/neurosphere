# Copy to .env (gitignored) and adjust as needed. No real secrets — local demo only.

# --- PostgreSQL (system of record) ---
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo_local_only
POSTGRES_DB=demo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Data API Builder ---
DAB_CONNECTION_STRING=Host=postgres;Port=5432;Database=demo;Username=demo;Password=demo_local_only
DAB_PORT=5000

# --- Identity (local OIDC/JWT issuer; stands in for Microsoft Entra ID) ---
ISSUER_PORT=8081
JWT_ISSUER=https://issuer.local
JWT_AUDIENCE=demo-api
# RS256 keys are generated by the issuer on first run; do not commit real keys.

# --- Gateway (Kong OSS, DB-less) ---
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
RATE_LIMIT_PER_MINUTE=60

# --- Catalog service ---
CATALOG_PORT=8080

# --- MCP server ---
MCP_PORT=8090

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin_local_only

# --- Cloud pricing helper (no auth; public API) ---
AZURE_PRICE_REGION=usgovvirginia

# --- Synthetic data ---
SYNTHETIC_SEED=42
