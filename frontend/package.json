{
  "name": "@neurosphere/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "format": "prettier --check .",
    "dev": "vite",
    "demo": "node scripts/demo.mjs",
    "build:report": "node scripts/bundle-report.mjs",
    "test:e2e": "playwright test --project=chromium --reporter=line",
    "test:visual": "playwright test --project=visual --reporter=line",
    "visual:update": "node scripts/update-visual-baselines.mjs",
    "visual:check": "node scripts/update-visual-baselines.mjs --check"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.27.0",
    "@azure/msal-react": "^5.7.4",
    "@fluentui/react-components": "^9.75.1",
    "@neurosphere/contracts": "workspace:*",
    "@tanstack/react-query": "^5.105.3",
    "graphology": "^0.26.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sigma": "^4.0.4",
    "vega": "^6.4.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
