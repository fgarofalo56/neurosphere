{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/notifications/v1/notification-subscription.schema.json",
  "title": "NotificationSubscription",
  "description": "Which event classes reach which channel and for which audience roles (PRP-99; body of admin_kind notification_subscription). Recipients are resolved inside the sender from the roles and are never stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subscription_id",
    "cloud",
    "customer_id",
    "domain_id",
    "channel_id",
    "event_classes",
    "audience_roles",
    "enabled"
  ],
  "properties": {
    "schema_version": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/schema_version"
    },
    "subscription_id": {
      "description": "Subscription id (slug).",
      "$ref": "../../admin/v1/common.schema.json#/$defs/slug"
    },
    "cloud": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/cloud"
    },
    "customer_id": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/customer_id"
    },
    "domain_id": {
      "$ref": "../../catalog/v1/common.schema.json#/$defs/domain_id"
    },
    "channel_id": {
      "description": "Channel this subscription delivers to.",
      "$ref": "../../admin/v1/common.schema.json#/$defs/slug"
    },
    "event_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/event_class"
      }
    },
    "audience_roles": {
      "description": "Roles whose members receive the notification.",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "../../admin/v1/common.schema.json#/$defs/role"
      }
    },
    "min_severity": {
      "description": "Lowest severity delivered.",
      "$ref": "../../policy/v1/policy-definition.schema.json#/$defs/severity",
      "default": "medium"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "$defs": {
    "event_class": {
      "title": "NotificationEventClass",
      "description": "What happened; open-ended: readers must tolerate unknown values.",
      "type": "string",
      "enum": [
        "policy_violation_opened",
        "policy_violation_escalated",
        "policy_violation_resolved",
        "policy_exception_requested",
        "policy_exception_decided",
        "hitl_item_assigned",
        "hitl_item_escalated",
        "hitl_item_expiring",
        "approval_requested",
        "approval_decided",
        "action_executed",
        "action_failed",
        "capture_policy_changed",
        "enforcement_mode_changed",
        "budget_threshold_crossed",
        "channel_delivery_failed"
      ]
    }
  }
}
