{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurosphere.invalid/schemas/compliance/v1/control-framework.schema.json",
  "title": "ControlFramework",
  "description": "A versioned framework and the controls the library names for it (PRP-56). Held as data under neurosphere_core/compliance/library. Naming a framework here is not a claim that anything is supported or covered; use 'mapped controls' and 'evidence observed'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_id",
    "title",
    "framework_version",
    "source_url",
    "source_retrieved",
    "controls"
  ],
  "properties": {
    "schema_version": { "$ref": "control.schema.json#/$defs/schema_version" },
    "framework_id": { "$ref": "control.schema.json#/$defs/framework_id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "framework_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source_url": { "type": "string", "pattern": "^https://[^\\s]{1,500}$" },
    "source_retrieved": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "control.schema.json" }
    }
  }
}
