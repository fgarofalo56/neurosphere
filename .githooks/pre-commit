#!/usr/bin/env bash
# NeuroSphere pre-commit guard: secrets, PII, credential-shaped paths, ruff.
# Wired via `git config core.hooksPath .githooks` (scripts/install-git-hooks.sh),
# so it is version-controlled and travels with the repo.
#
# This is a LOCAL fast fail. CI (.github/workflows/secret-scan.yml) is the real
# backstop: a local hook can be bypassed with --no-verify.
set -uo pipefail

fail=0
note() { printf '\033[31mBLOCKED\033[0m %s\n' "$1" >&2; fail=1; }

# Every staged change, including renames and deletions (a PRP move is a rename).
all_staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$all_staged" ] && exit 0
# Content checks only look at added/copied/modified files.
staged=$(git diff --cached --name-only --diff-filter=ACM)

# The scanners contain the patterns they hunt for. Keep this list narrow and
# path-based; never allowlist a file that could plausibly hold a real credential.
self_scanners='^(\.githooks/|\.github/workflows/secret-scan\.yml$|\.gitleaks\.toml$|scripts/validate_planning\.py$)'
scan_files=$(printf '%s\n' "$staged" | grep -vE "$self_scanners")

# 1) Files that must never be committed, by path.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    .env|.env.*|*/.env|*/.env.*)
      case "$f" in *.env.example) continue ;; esac
      note "$f - environment file. Use .env.example with placeholder values." ;;
    *.pem|*.key|*.pfx|*.p12|*.jks|*.keystore|*_rsa|*_ed25519|.netrc|.pgpass)
      note "$f - looks like a private key or credential store." ;;
    credentials.json|*/credentials.json|service-account*.json|*/service-account*.json|azure.json|*.publishsettings)
      note "$f - looks like a cloud credential file." ;;
    secrets/*|*/secrets/*)
      note "$f - under secrets/." ;;
  esac
done <<< "$staged"

# 2) Content patterns over the staged diff only (fast, high-signal).
if [ -n "$scan_files" ]; then
  diff_content=$(git diff --cached -U0 --diff-filter=ACM -- $scan_files)
  PLACEHOLDER='(example|placeholder|change-me|your-|xxx+|<[a-z-]+>|not-the-key|dummy|fake|redacted|s3cret-test)'
  scan() {  # scan <ERE> <description>
    local hits
    hits=$(printf '%s' "$diff_content" | grep -nIE "^\+.*$1" | grep -viE "$PLACEHOLDER" | head -3)
    [ -n "$hits" ] && note "possible $2:
$hits"
  }
  scan 'AKIA[0-9A-Z]{16}'                          "AWS access key id"
  scan 'aws_secret_access_key[[:space:]]*='        "AWS secret key"
  scan '(gh[pousr]_[A-Za-z0-9]{30,})'              "GitHub token"
  scan 'sk-(ant-)?[A-Za-z0-9_-]{24,}'              "LLM API key (OpenAI/Anthropic style)"
  scan 'xox[baprs]-[A-Za-z0-9-]{10,}'              "Slack token"
  scan 'BEGIN [A-Z ]*PRIVATE KEY'                  "private key block"
  scan 'eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}' "JWT"
  scan 'DefaultEndpointsProtocol=.*AccountKey='    "Azure storage connection string"
  scan 'SharedAccessKey=[A-Za-z0-9+/=]{20,}'       "Azure SAS / Event Hubs connection string"
  scan '(password|passwd|pwd|secret|api[_-]?key|bearer)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}' "hardcoded credential"
  # 3) PII the product must never store in source.
  scan '\b[0-9]{3}-[0-9]{2}-[0-9]{4}\b'            "US Social Security Number"
  scan '\b(4[0-9]{12}([0-9]{3})?|5[1-5][0-9]{14})\b' "payment card number"
fi

# 4) PRP status table: when any PRPs/ file is staged, regenerate the table in
#    the master index from the directory layout and stage the result, so a
#    moved PRP never leaves the index stale.
#    A move is a rename (R) or delete+add, which the ACM filter above hides,
#    so this step looks at every staged change.
if printf '%s\n' "$all_staged" | grep -qE '^PRPs/'; then
  if python scripts/prp_status.py --write >/dev/null 2>&1; then
    git add PRPs/PRP-MASTER-neurosphere.md
  else
    note "scripts/prp_status.py --write failed; run it by hand to see why"
  fi
fi

# 5) Ruff on staged Python, when the toolchain is present. Lint-only, no fix.
py_staged=$(printf '%s\n' "$staged" | grep -E '\.pyi?$' || true)
if [ -n "$py_staged" ] && command -v uv >/dev/null 2>&1 && [ -f pyproject.toml ]; then
  if ! uv run --quiet ruff check --no-fix $py_staged; then
    note "ruff check failed on staged Python files (run: uv run ruff check --fix)"
  fi
  if ! uv run --quiet ruff format --check $py_staged; then
    note "ruff format check failed (run: uv run ruff format)"
  fi
fi

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

Commit blocked by .githooks/pre-commit.
If this is a false positive, fix the pattern in .githooks/pre-commit rather than
reaching for --no-verify. If you have already committed a real secret: rotate it
first, then rewrite history. Removing it in a later commit does NOT make it safe.
MSG
  exit 1
fi
exit 0
