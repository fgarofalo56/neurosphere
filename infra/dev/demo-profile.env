# Demo profile (PRP-71 item 4): names and NON-SECRET values only. Applied by `make demo-up`
# (sourced into the shell that runs `docker compose`; no ids or keys live here).
# Every host is loopback (127.0.0.1, never localhost). The Entra ids stay exported by the operator.

# Producers come from the admin store (PRP-41).
NS_INGEST_PRODUCER_STORE=true

# The workers already run NS_WORKER_ROLES=all (compose literal), which includes recommendations
# and the connector roles (gateway_poll, foundry_discovery, billing_export, detections); the
# connector roles stay idle until a connector config exists. Only the recommendation source moves.
NS_WORKER_REC_SOURCE=archive

# MCP resource server on, resolving locally (the resource URL must be https).
NS_MCP_RESOURCE_SERVER_URL=https://127.0.0.1:8000/mcp
NS_MCP_AUDIENCES='["https://127.0.0.1:8000/mcp"]'
NS_MCP_ALLOWED_HOSTS='["127.0.0.1:8000"]'

# Deployment scan on; lifecycle decides and audits only (never mutates).
NS_SCAN_ENABLED=true
NS_LIFECYCLE_MODE=dry_run

# The single copilot switch. Always disabled in PRP-71; PRP-78 flips it.
NS_DEMO_COPILOT_MODE=disabled
