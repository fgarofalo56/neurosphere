{
  "name": "NeuroSphere",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "forwardPorts": [8081, 10000, 10001, 10002, 5672, 9092],
  "portsAttributes": {
    "8081": { "label": "Cosmos DB vNext emulator" },
    "10000": { "label": "Azurite Blob" },
    "10001": { "label": "Azurite Queue" },
    "10002": { "label": "Azurite Table (preview)" },
    "5672": { "label": "Event Hubs emulator (AMQP)" },
    "9092": { "label": "Event Hubs emulator (Kafka)" }
  },
  "containerEnv": {
    "NS_ENV": "local"
  },
  "postCreateCommand": "pip install --user 'uv==0.12.*' && npm install -g pnpm@11 && uv sync --frozen && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
